{
  "name": "browse-ai",
  "version": "1.4.0",
  "scripts": {
    "build:background": "tsc -p tsconfig.background.json",
    "prestart": "npm run build:background",
    "ng": "ng",
    "start": "ng build --watch --configuration development",
    "prebuild": "npm run build:background",
    "build": "ng build",
    "test": "ng test --no-watch",
    "prebuild:extension": "npm run build:background",
    "build:extension": "ng build --configuration production && npm run package",
    "package": "rm -f browseai-extension.zip && cd dist/browse-ai && zip -qr ../../browseai-extension.zip .",
    "prettier": "prettier --write \"**/*\""
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "browse-ai-core": "^0.4.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.0",
    "@types/chrome": "^0.2.5",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
